# App
# En IIS: 127.0.0.1 para que solo IIS acceda al backend.
APP_HOST=0.0.0.0
APP_PUERTO=3000
APP_AMBIENTE=desarrollo
APP_NOMBRE=NEXUS
APP_PREFIJO_API=api
CARGA_MASIVA_MAX_FILAS=2000

# JWT
JWT_SECRETO=cambiar-esto-en-produccion-por-favor
JWT_EXPIRA_EN=8h

# Oracle
ORACLE_HOST=192.168.184.148
ORACLE_PUERTO=1521
ORACLE_SERVICIO=dwsuka
ORACLE_USUARIO=CI_PANEL
ORACLE_CONTRASENA=
ORACLE_ESQUEMA=dwh_suka
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
# Ruta del Oracle Instant Client. Requerido para Oracle 11g (activa modo Thick).
# Si la BD es >=12.1 puede dejarse vacío y se usa modo Thin.
ORACLE_LIB_DIR=

# SQL Server
SQLSERVER_HOST=SRV-MIGSK2
SQLSERVER_PUERTO=1433
SQLSERVER_BD=Gobierno
SQLSERVER_USUARIO=admin
SQLSERVER_CONTRASENA=
SQLSERVER_POOL_MIN=1
SQLSERVER_POOL_MAX=5

# Active Directory
AD_DOMINIO=gviz.com
AD_URL=ldap://gviz.com:389
AD_BASE_DN=dc=gviz,dc=com

# Logs
LOG_DIRECTORIO=C:\logs\nexus
LOG_NIVEL=info
LOG_RETENCION_DIAS=30

# Avisos por correo de altas y bajas en CARNET
# Si SMTP_HOST está vacío, el módulo sigue funcionando sin enviar correos.
# Nunca registrar contraseñas reales en este archivo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=centraldeinformacion@sukarne.com
SMTP_PASSWORD=
SMTP_REMITENTE=centraldeinformacion@sukarne.com
# Destinatarios globales; solo se usan si CARNET_USAR_CORREO_POSICION=false.
ALERTA_DESTINATARIOS_DEFAULT=
# Correo único de pruebas: redirige altas, bajas, carga masiva, solicitudes, mensajes personalizados y ambas etapas SLA.
# También redirige pendientes existentes. Vacío usa los destinatarios normales. Reiniciar tras cambiarlo.
NOTIFICACIONES_DESTINATARIO_FORZADO=
# false: usa los destinatarios globales; true: consulta el correo de la posición.
# Para destinatarios reales: true y NOTIFICACIONES_DESTINATARIO_FORZADO vacío.
# Si no se encuentra correo de la posición no se sustituye por el global.
CARNET_USAR_CORREO_POSICION=false
CARNET_AVISOS_ESCALONADOS_ACTIVOS=false
# Configurar informes y plazos exclusivamente en el módulo Configuración SLA (SQL Server).
# Sin informes activos en la tabla, ninguna nueva asignación aplica SLA.
# Respaldo de destinatarios iniciales solo si aún no hay configuración general guardada.
CARNET_SLA_DESTINATARIOS=
# Las antiguas claves CARNET_SLA_INFORMES, CARNET_SLA_MINUTOS y CARNET_SLA_HORAS se ignoran.
CARNET_AVISOS_INTERVALO_SEGUNDOS=60
CARNET_AVISOS_ZONA_HORARIA=America/Mexico_City

# Estáticos del frontend compilado
ESTATICOS_DIRECTORIO=./public

# Cierra solicitudes parciales a los tres días hábiles, sin aplicar filas pendientes.
SOLICITUDES_CIERRE_AUTOMATICO_ACTIVO=true
